# Servidor y origenes permitidos (separados por coma)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://proyecto-web-y-movil.vercel.app

# Reemplazar antes de usar fuera del entorno de desarrollo
JWT_SECRET=reemplazar_con_secreto_seguro_min_32_caracteres
JWT_EXPIRES_IN=2h

# PostgreSQL local: crear tcgstore en pgAdmin y ejecutar database/esquema.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_NAME=tcgstore
DB_SSL=false

# Nube (Neon/Supabase): usar DATABASE_URL en lugar de las variables separadas
# DATABASE_URL=postgresql://usuario:password@host:5432/tcgstore?sslmode=require
# DB_SSL=true
