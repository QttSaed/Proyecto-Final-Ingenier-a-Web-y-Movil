# Servidor y orígenes permitidos (separados por coma)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://proyecto-web-y-movil.vercel.app

# JSON Web Tokens (Reemplazar antes de usar fuera del entorno de desarrollo)
JWT_SECRET=reemplazar_con_secreto_seguro_min_32_caracteres
JWT_EXPIRES_IN=2h

# PostgreSQL local: crear tcgstore en pgAdmin y ejecutar database/esquema.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_NAME=tcgstore
DB_SSL=false

# Nube (Supabase / Neon): usar DATABASE_URL en lugar de las variables separadas
# DATABASE_URL=postgresql://usuario:password@host:5432/tcgstore?sslmode=require
# DB_SSL=true

# Google OAuth 2.0 (obtenido en Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Correo transaccional con Gmail (Nodemailer)
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion
